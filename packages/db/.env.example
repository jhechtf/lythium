# Example environment for packages/db (drizzle-kit and src/migrate.ts).
# NOTE: these scripts do not load .env files. Export the variable into the
# process environment first, e.g.  set -a; . packages/db/.env; set +a
# Never commit real values.

# Required, no default. Postgres connection string used for migrations.
# Deliberately named DB_URL here, whereas apps/api and apps/github-app read
# DATABASE_URL. The value below matches the local docker-compose database.
DB_URL=postgres://lythium:lythium@localhost:5432/lythium
