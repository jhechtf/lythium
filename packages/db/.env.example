# drizzle-kit and src/migrate.ts do not load .env: export it first (set -a; . packages/db/.env; set +a).
# Never commit real values.

# Required, no default. Postgres URL for migrations (local docker-compose value).
# Named DB_URL here; apps/api and apps/github-app read DATABASE_URL instead.
DB_URL=postgres://lythium:lythium@localhost:5432/lythium
