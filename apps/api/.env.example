# Example environment for apps/api. Copy to .env and edit.
# NOTE: the API does not load .env files itself (`tsx watch main.ts`).
# Export these into the process environment before starting, e.g.
#   set -a; . apps/api/.env; set +a
# Never commit real values.

# Optional. Port the HTTP server listens on. Default: 3000.
PORT=3000

# Optional for the server to start; required for DB-backed guided-review routes
# (they return 503 when unset or empty). Postgres connection string.
# This value matches the local docker-compose database.
# (packages/db tooling uses DB_URL instead; see packages/db/.env.example.)
DATABASE_URL=postgres://lythium:lythium@localhost:5432/lythium

# Optional. Anthropic API key for AI clustering. Calls are billed, so leave
# empty unless you want them. Empty: no model is configured and clustering
# falls back to directory grouping.
ANTHROPIC_API_KEY=

# Optional. Clustering provider: `anthropic` or `none`. Default (empty):
# `anthropic` when ANTHROPIC_API_KEY is non-empty, otherwise `none`.
# `none` always disables the model.
CLUSTER_PROVIDER=

# Optional. Anthropic model used for clustering. Default: claude-opus-5-5.
CLUSTER_MODEL=

# Optional. Max model calls per instance per hour. Must be a positive integer;
# blank, invalid, zero, negative or fractional values fall back to the default
# of 300 (zero does NOT disable AI). When exhausted, directory grouping is used.
CLUSTER_MAX_CALLS_PER_HOUR=300

# Optional. GitHub token, only used by the `measure:inbox` diagnostic script
# (scripts/measure-inbox.ts). Not used by the service itself.
GITHUB_TOKEN=
