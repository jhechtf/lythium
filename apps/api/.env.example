# apps/api does not load .env itself: export it first (set -a; . apps/api/.env; set +a).
# Never commit real values.

# Optional. HTTP port. Default: 3000.
PORT=3000

# Optional; required for DB-backed guided-review routes (503 if unset/empty). Local docker-compose value.
# packages/db uses DB_URL instead; see packages/db/.env.example.
DATABASE_URL=postgres://lythium:lythium@localhost:5432/lythium

# Optional. Billed: keep empty unless you want AI clustering.
# Empty means no model; clustering falls back to directory grouping.
ANTHROPIC_API_KEY=

# Optional. `anthropic` or `none` (none always disables). Default (empty): anthropic if key is set, else none.
CLUSTER_PROVIDER=

# Optional. Anthropic model for clustering. Default: claude-opus-5-5.
CLUSTER_MODEL=

# Optional. Model calls per instance/hour; positive integer, else default 300 (0 does NOT disable AI).
# When exhausted, directory grouping is used.
CLUSTER_MAX_CALLS_PER_HOUR=300

# Optional. Only used by the `measure:inbox` diagnostic script, not by the service.
GITHUB_TOKEN=
