# Loaded by the service via dotenv/config. See docs/github-app.md. Never commit real values.

# Required. Postgres connection string (local docker-compose value).
# packages/db uses DB_URL instead; see packages/db/.env.example.
DATABASE_URL=postgres://lythium:lythium@localhost:5432/lythium

# Required. Numeric App ID from the GitHub App's settings page.
GITHUB_APP_ID=123456

# Required. Filesystem PATH to the .pem private key, NOT its contents.
# Use an absolute path outside the repo (no ~ or $HOME expansion).
GITHUB_APP_PRIVATE_KEY="/absolute/path/outside-repo/github-app.pem"

# Required. Must equal the webhook secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Optional. HTTP port. Default: 3001.
PORT=3001

# Optional. `production` disables dev-only Smee forwarding; unset or other values mean development.
NODE_ENV=development

# Required in dev (ignored in production): your smee.io channel URL (https://smee.io/new).
# Events forward to http://localhost:3001/webhook (hardcoded port), so keep PORT=3001.
SMEE_PROXY=https://smee.io/your-channel-id
