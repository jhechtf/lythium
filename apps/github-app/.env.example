# Example environment for apps/github-app. Copy to .env and edit.
# This service loads .env itself via dotenv/config.
# See docs/github-app.md for setup. Never commit real values.

# Required. Postgres connection string (matches the local docker-compose database).
# (packages/db tooling uses DB_URL instead; see packages/db/.env.example.)
DATABASE_URL=postgres://lythium:lythium@localhost:5432/lythium

# Required. Numeric App ID from the GitHub App's settings page.
GITHUB_APP_ID=123456

# Required. Filesystem PATH to the App's downloaded .pem private key, NOT the
# PEM contents. Use an absolute path (no ~ or $HOME expansion) outside the repo.
GITHUB_APP_PRIVATE_KEY="/absolute/path/outside-repo/github-app.pem"

# Required. Must equal the webhook secret configured on the GitHub App.
GITHUB_WEBHOOK_SECRET=replace-with-webhook-secret

# Optional. HTTP port. Default: 3001.
PORT=3001

# Optional. `production` disables the dev-only Smee forwarding. Unset or any
# other value is treated as development.
NODE_ENV=development

# Required by the development entry point, ignored when NODE_ENV=production.
# Your smee.io channel URL (https://smee.io/new). Events are forwarded to
# http://localhost:3001/webhook (port is hardcoded, so keep PORT=3001 in dev).
SMEE_PROXY=https://smee.io/your-channel-id
