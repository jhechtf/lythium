# Copy to .env for local development. These are read at build time via
# `$env/static/private`, so they must be defined for `vite build` / `svelte-check`.
GITHUB_APP_CLIENT_ID=your-github-app-client-id
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret
# Base URL of the Lythium API (apps/api), no trailing slash.
API_URL=http://localhost:3000
