# Copy to .env for local development. SvelteKit loads it. These are server-only
# and read at build time via `$app/env/private` (declared in `src/env.ts`), so
# they must be defined for `vite build` / `svelte-check`. All three are required
# and must be non-empty; there are no defaults.

# Required. Client ID of the GitHub App (see docs/github-app.md).
GITHUB_APP_CLIENT_ID=your-github-app-client-id

# Required. Client secret of the GitHub App. Keep private.
GITHUB_APP_CLIENT_SECRET=your-github-app-client-secret

# Required. Base URL of the Lythium API (apps/api), no trailing slash.
# http://localhost:3000 matches the API's default port; it is not a code default.
API_URL=http://localhost:3000
